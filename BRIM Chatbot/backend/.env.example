# Copy to backend/.env and fill in. Never commit the real .env.

# ── Core ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-unique-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_DB=brim_ai_db
POSTGRES_USER=brim_user
POSTGRES_PASSWORD=change-me
# Optional full override; keep the psycopg2 driver name.
# DATABASE_URL=postgresql+psycopg2://brim_user:change-me@localhost:5433/brim_ai_db
ALLOW_SQLITE_FALLBACK=false

# ── CORS (comma separated or JSON array) ─────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# ── AI (optional) ────────────────────────────────────────────────────────────
# Without a key the platform uses local embeddings and deterministic grounded answers.
OPENAI_API_KEY=
EMBEDDING_PROVIDER=auto

# ── Guard rails ──────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── Greeting context (optional) ──────────────────────────────────────────────
WEATHER_ENABLED=true
WEATHER_PROVIDER=open-meteo
WEATHER_MENTION_PROBABILITY=0.35
ENGAGEMENT_ENABLED=true
ENGAGEMENT_PROBABILITY=0.5
# HOLIDAY_FILE=demo_documents/holidays.json
