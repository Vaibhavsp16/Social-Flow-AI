# Copy to backend/.env and fill in. Never commit the real .env.

# ── Core ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-unique-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_SERVER=localhost
POSTGRES_PORT=5433
POSTGRES_DB=brim_ai_db
POSTGRES_USER=brim_user
POSTGRES_PASSWORD=change-me
# Optional full override; keep the psycopg2 driver name.
# DATABASE_URL=postgresql+psycopg2://brim_user:change-me@localhost:5433/brim_ai_db
ALLOW_SQLITE_FALLBACK=false

# ── CORS (comma separated or JSON array) ─────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# ── AI (optional) ────────────────────────────────────────────────────────────
# Without a key the platform uses local embeddings and deterministic grounded answers.
OPENAI_API_KEY=
EMBEDDING_PROVIDER=auto

# ── Guard rails ──────────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true

# ── Public links, embed and custom domains ───────────────────────────────────
# Where the web app is served. Share links, the /p/{slug} page and the embed widget are all built
# from this, so a wrong value here produces links that look fine and go nowhere.
FRONTEND_BASE_URL=https://social-flow-ai-frontend.vercel.app
# Hostname a customer's CNAME should point at. Defaults to the FRONTEND_BASE_URL host.
# PUBLIC_APP_HOST=social-flow-ai-frontend.vercel.app

# ── Google sign-in (optional) ────────────────────────────────────────────────
# Client ID from Google Cloud Console → APIs & Services → Credentials → OAuth client (Web).
# Add every origin that will show the button under "Authorised JavaScript origins":
#   http://localhost:5173, https://your-frontend.vercel.app, https://chat.yourcustomer.com
# With this unset, the API returns 503 naming it and the sign-in button explains that it is off.
GOOGLE_CLIENT_ID=

# ── Greeting context (optional) ──────────────────────────────────────────────
WEATHER_ENABLED=true
WEATHER_PROVIDER=open-meteo
WEATHER_MENTION_PROBABILITY=0.35
ENGAGEMENT_ENABLED=true
ENGAGEMENT_PROBABILITY=0.5
# HOLIDAY_FILE=demo_documents/holidays.json
